# Copy to /etc/poselyanov3dprint/.env on VPS (chmod 600)

BOT_TOKEN=
OWNER_ID=718746623
ORDERS_CHAT_ID=

WEBAPP_URL=https://denisposelyanov.github.io/poselyanov3dprint/
ADMIN_WEBAPP_URL=https://api.yourdomain.ua/admin/panel
API_PUBLIC_URL=https://api.yourdomain.ua

VALIDATE_INIT_DATA=true
LOCAL_DEV_MODE=false
PORT=8080

# sqlite (default) or postgres for Supabase
DB_BACKEND=sqlite
DB_FILE=/var/lib/poselyanov3dprint/users.db
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require

CATALOG_BACKEND=sqlite
# CATALOG_BACKEND=postgres

CORS_ORIGINS=https://denisposelyanov.github.io,https://api.yourdomain.ua,http://localhost:8080

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PROMOTION_ENABLED=true
BROADCAST_DELAY_SEC=0.05

# --- Docker / local dev ---
# Токен з https://dashboard.ngrok.com/authtokens
NGROK_AUTHTOKEN=
# Вставити сюди URL тунелю після `docker compose up` (дивись http://localhost:4040)
# API_PUBLIC_URL=https://xxxx-xx-xx-xx-xx.ngrok-free.app
# LOCAL_DEV_MODE=true
# VALIDATE_INIT_DATA=false
