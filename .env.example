# Copy to /etc/poselyanov3dprint/.env on VPS (chmod 600)

BOT_TOKEN=
OWNER_ID=your_telegram_user_id
ORDERS_CHAT_ID=

WEBAPP_URL=https://denisposelyanov.github.io/poselyanov3dprint/
ADMIN_WEBAPP_URL=https://api.yourdomain.ua/admin/panel
API_PUBLIC_URL=https://api.yourdomain.ua

# Не вказуйте ngrok у WEBAPP_URL — free ngrok показує сторінку «Visit Site» у Telegram WebView.
# Фронтенд: GitHub Pages. API: ngrok або VPS (див. api-config.js).

VALIDATE_INIT_DATA=true
LOCAL_DEV_MODE=false
# ALLOW_LOCAL_NETWORK=false
INIT_DATA_MAX_AGE_SEC=86400
PORT=8080

# Стабільний токен для bypass=admin (ngrok/VPS без Telegram). Якщо порожній — генерується на кожен рестарт.
# ADMIN_BYPASS_TOKEN=

# sqlite (default) or postgres for Supabase
DB_BACKEND=sqlite
DB_FILE=/var/lib/poselyanov3dprint/users.db
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require

CATALOG_BACKEND=sqlite
# CATALOG_BACKEND=postgres

CORS_ORIGINS=https://denisposelyanov.github.io,https://api.yourdomain.ua

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upload limits are bytes. Request limit includes multipart overhead.
# MAX_UPLOAD_BYTES=26214400
# MAX_UPLOAD_REQUEST_BYTES=27262976

PROMOTION_ENABLED=true
BROADCAST_DELAY_SEC=0.05
# DROP_PENDING_UPDATES=false  # true лише для debug — інакше втрачаються updates при рестарті
# COMMAND_COOLDOWN_SEC=2.0    # мін. інтервал між повторними /start від одного користувача

# Дозволені статичні файли для HTTP-роуту (через кому). За замовчуванням — index.html, admin-panel.html, json, shared.js, api-config.js
# STATIC_ALLOWED_FILES=index.html,admin-panel.html,logo.svg,logo-dark.svg,shared.js,api-config.js,products.json,custom_products.json,categories.json,filaments.json

# --- Docker + ngrok (локальна розробка) ---
NGROK_DOMAIN=your-ngrok-subdomain.ngrok-free.dev
NGROK_AUTHTOKEN=

# --- GitHub Pages + API ---
# Фронтенд на GitHub Pages читає URL API з api-config.js (скопіюйте з api-config.example.js).
# API_PUBLIC_URL має збігатися з window.__API_BASE__ у api-config.js
#
# Локальна розробка (НЕ для продакшну — дозволяє підміну user_id у запитах):
# LOCAL_DEV_MODE=true
# VALIDATE_INIT_DATA=false
# ALLOW_LOCAL_NETWORK=true
# CORS_ORIGINS=https://denisposelyanov.github.io,http://localhost:8080,http://127.0.0.1:8080
