BOT_TOKEN=your_bot_token_here
# Локально залиш false — працює без Telegram initData
VALIDATE_INIT_DATA=false
# Коли задеплоїш API — true
# VALIDATE_INIT_DATA=true

PORT=8080
# ID адміна (особистий Telegram user id, позитивний)
OWNER_ID=718746623
# ID чату/каналу, куди надсилати замовлення (може бути -100...)
ORDERS_CHAT_ID=-1003739884073
CORS_ORIGINS=https://denisposelyanov.github.io,http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500

# WebApp URL для адмін панелі (локально або публічний URL)
ADMIN_WEBAPP_URL=http://localhost:8080/admin/panel
# На проді використовуй публічний URL:
# ADMIN_WEBAPP_URL=https://your-domain.com/admin/panel

# Cloudinary для зберігання фото
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
